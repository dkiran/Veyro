DATABASE_URL=postgres://veyro:veyro@localhost:5432/veyro
JWT_SECRET=change-me-in-production
PORT=4000

# AI assistant (chat bubble). Leave unset to disable; the app works without it.
# ANTHROPIC_API_KEY=sk-ant-...
# VEYRO_AI_MODEL=claude-opus-5-5
# VEYRO_AI_EFFORT=medium

# Website enquiries (contact form on veyrotrack.com) are saved in the database and emailed through ZeptoMail.
# Leave ZEPTOMAIL_TOKEN unset to only save them.
# ZEPTOMAIL_TOKEN=Zoho-enczapikey ...
# ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
# MAIL_FROM=noreply@veyrotrack.com
# MAIL_FROM_NAME=Veyro Website
# ENQUIRY_MAIL_TO=sales@veyrotrack.com
